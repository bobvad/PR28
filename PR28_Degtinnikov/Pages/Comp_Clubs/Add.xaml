<Page x:Class="PR28_Degtinnikov.Pages.Comp_Clubs.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR28_Degtinnikov.Pages.Comp_Clubs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление компьютерного клуба">

    <Grid Background="LightSteelBlue">
        <Grid Margin="30" Background="White" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.ColumnSpan="3" Text="Добавление компьютерного клуба" 
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      FontSize="20" FontWeight="Bold" Foreground="DarkSlateBlue" 
                      Margin="0,20,0,30"/>

            <Border Grid.Row="1" Grid.Column="0" Width="80" Height="100" 
                   Background="LightGray" CornerRadius="5" Margin="20,0,20,20"
                   VerticalAlignment="Top">
                <Image Source="/Images/priority-headline-background.png" 
                      Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Height="72" Width="80"/>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,20" VerticalAlignment="Top">
                <Label Content="Наименование" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,0,0,5"/>
                <TextBox x:Name="name" Height="35" FontSize="14" BorderBrush="LightGray" BorderThickness="2" 
                        TextWrapping="Wrap" VerticalAlignment="Center" Padding="5"/>

                <Label Content="Адрес" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,15,0,5"/>
                <TextBox x:Name="address" Height="35" FontSize="14" BorderBrush="LightGray" BorderThickness="2" 
                        TextWrapping="Wrap" VerticalAlignment="Center" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,10,20" VerticalAlignment="Top">
                <Label Content="Время работы" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="Time" Height="35" Width="248" FontSize="14" BorderBrush="LightGray" BorderThickness="2"
                            TextWrapping="Wrap" VerticalAlignment="Center" Padding="5"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" 
                       HorizontalAlignment="Center" Margin="0,30,0,20">
                <Button x:Name="bthAdd" Background="RoyalBlue" Content="Добавить" 
                       Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" Height="40" Width="120" 
                       Click="AddRecord" Margin="10,0" BorderThickness="0"/>

                <Button Content="Просмотр карточек" Background="SteelBlue" 
                       Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" Height="40" Width="150" 
                       Click="Button_Click" Margin="10,0" BorderThickness="0" />

                <Button Content="На главную страницу" Background="SlateGray" 
                       Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" Height="40" Width="160" 
                       Click="ForGlavPage" Margin="10,0" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>