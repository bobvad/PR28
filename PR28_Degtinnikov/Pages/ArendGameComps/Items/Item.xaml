<UserControl x:Class="PR28_Degtinnikov.Pages.ArendGameComps.Items.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="500">

    <Border Background="White" Margin="10,5" BorderBrush="#E0E0E0" BorderThickness="1" 
            CornerRadius="8" >
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="60" Height="80" Background="#F5F5F5" 
                    CornerRadius="6" VerticalAlignment="Top" Margin="0,5,0,0">
                <Image Source="/Images/1STPLAYER MIKU Mi2-A BLACK 1.jpg" 
                       Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="15,5,0,0">
                <TextBlock Text="Аренда компьютера" FontWeight="SemiBold" FontSize="14" 
                          Foreground="#2C3E50" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО клиента:" 
                              FontWeight="Medium" Foreground="#555" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="clientName" 
                            BorderBrush="#DDD" BorderThickness="1" Padding="5" Height="28" 
                            FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата:" 
                              FontWeight="Medium" Foreground="#555" Margin="0,0,10,5" VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="Date" 
                               BorderBrush="#DDD" Height="28" FontSize="12" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Время:" 
                              FontWeight="Medium" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="time" 
                            BorderBrush="#DDD" BorderThickness="1" Padding="5" Height="28" 
                            FontSize="12" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" 
                       Margin="15,0,0,0" Width="90">
                <Button x:Name="bthUpdate" Content="Редакт." Background="#3498DB" 
                       Foreground="White" FontWeight="SemiBold" FontSize="11" 
                       Height="30" Margin="0,0,0,8" BorderThickness="0" 
                       Click="Update" />
                <Button x:Name="bthDelete" Content="Удалить" Background="#E74C3C" 
                       Foreground="White" FontWeight="SemiBold" FontSize="11" 
                       Height="30" BorderThickness="0" Click="Delete" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>