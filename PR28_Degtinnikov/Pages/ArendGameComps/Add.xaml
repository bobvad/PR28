<Page x:Class="PR28_Degtinnikov.Pages.ArendGameComps.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR28_Degtinnikov.Pages.ArendGameComps"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление аренды">

    <Grid Background="LightSteelBlue">
        <Grid Margin="30" Background="White" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Аренда игрового компьютера" 
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      FontSize="20" FontWeight="Bold" Foreground="DarkSlateBlue" 
                      Margin="0,20,0,30"/>
            <Border Grid.Row="1" Grid.Column="0" Width="100" Height="120" 
                   Background="LightGray" CornerRadius="5" Margin="20,0,20,20"
                   VerticalAlignment="Top">
                <Image Source="/Images/1STPLAYER MIKU Mi2-A BLACK 1.jpg" 
                      Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,20" VerticalAlignment="Top">
                <Label Content="Дата" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,0,0,5"/>
                <DatePicker x:Name="Date" Height="35" FontSize="14" BorderBrush="LightGray" BorderThickness="2" />

                <Label Content="Время" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,15,0,5"/>
                <TextBox x:Name="Time" Height="35" FontSize="14" BorderBrush="LightGray" BorderThickness="2" 
                        TextWrapping="Wrap" VerticalAlignment="Center" Padding="5"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,10,20" VerticalAlignment="Top">
                <Label Content="ФИО клиента" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,0,0,5"/>
                <TextBox x:Name="clientName" Height="35" FontSize="14" BorderBrush="LightGray" BorderThickness="2"
                        TextWrapping="Wrap" VerticalAlignment="Center" Padding="5"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" 
                       HorizontalAlignment="Center" Margin="0,30,0,20">
                <Button x:Name="bthAdd" Background="RoyalBlue" Content="Добавить" 
                       Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" Height="40" Width="120" 
                       Click="AddRecord" Margin="10,0" BorderThickness="0" />

                <Button Content="Просмотр карточек" Background="SteelBlue" 
                       Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" Height="40" Width="150" 
                       Click="Button_Click" Margin="10,0" BorderThickness="0"/>

                <Button Content="На главную страницу" Background="SlateGray" 
                       Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" Height="40" Width="160" 
                       Click="Button_Click_1" Margin="10,0" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>