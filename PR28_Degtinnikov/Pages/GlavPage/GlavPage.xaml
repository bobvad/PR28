<Page x:Class="PR28_Degtinnikov.Pages.GlavPage.GlavPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR28_Degtinnikov.Pages.GlavPage"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GlavPage">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="Gaming Rent System" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="White"/>
            <TextBlock Text="Аренда игровых компьютеров и поиск компьютерных клубов" 
                       FontSize="16" 
                       HorizontalAlignment="Center" 
                       Foreground="White" 
                       Opacity="0.9"/>
        </StackPanel>
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="20">

            <Button x:Name="BtnRentPC" 
                    Content=" Аренда ПК" 
                    Width="250" 
                    Height="100" 
                    Background="#FF4169E1" 
                    Foreground="White" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Margin="20"
                    Click="BtnRentPC_Click"
                    Cursor="Hand"
                    BorderThickness="0"
                    >
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                </Button.Effect>
            </Button>

            <Button x:Name="BtnClubs" 
                    Content=" Клубы" 
                    Width="250" 
                    Height="100" 
                    Background="#FF32CD32" 
                    Foreground="White" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Margin="20"
                    Click="BtnClubs_Click"
                    Cursor="Hand"
                    BorderThickness="0"
                   >
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                </Button.Effect>
            </Button>

        </StackPanel>
    </Grid>
</Page>
